# Supabase Dashboard > Project Settings > API থেকে নিন
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ঐচ্ছিক: ওয়েবসাইটের পূর্ণ ঠিকানা (শেয়ার লিংকের জন্য)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ঐচ্ছিক: "আমার বকেয়া" পেজে বকেয়া থাকলে যে নির্দেশনা দেখাবে
NEXT_PUBLIC_PAYMENT_NOTE=বিকাশ/নগদ (পার্সোনাল): 01XXXXXXXXX — রেফারেন্সে আপনার নাম লিখুন।
